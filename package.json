{
  "name": "nms-monitoring",
  "version": "1.0.0",
  "description": "Network Monitoring System - Backend API + Poller + Frontend SPA (zero dependency, Node.js >= 22)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "poller": "node poller.js",
    "add-local": "node scripts/add-local-devices.js",
    "scan-lan": "node scripts/scan-lan.js",
    "wifi-scan": "node scripts/wifi-scan.js",
    "identify": "node scripts/identify-hosts.js",
    "cleanup-demo": "node scripts/cleanup-demo-alerts.js",
    "dev": "node server.js",
    "tunnel": "node scripts/tunnel-start.js",
    "online": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "watchdog": "powershell -ExecutionPolicy Bypass -File scripts/watchdog.ps1",
    "autostart": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:off": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -Uninstall",
    "deploy": "node scripts/pages-deploy.js",
    "deploy:pages": "node scripts/pages-deploy.js",
    "deploy:worker": "echo SKIP: workers.dev dimatikan (wrangler.jsonc workers_dev=false). Website utama = https://nms-eov.pages.dev. Gunakan 'npm run deploy:pages'.",
    "verify": "node scripts/verify.js",
    "verify:worker": "node scripts/worker-check.js",
    "verify:menu": "node scripts/menu-check.js",
    "verify:layout": "node scripts/layout-check.js",
    "verify:edge": "node scripts/edge-check.js",
    "check:responsive": "node scripts/device-check.js / /halaman-404-xyz"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
