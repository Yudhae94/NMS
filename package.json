{
  "name": "nms-monitoring",
  "version": "1.0.0",
  "description": "Network Monitoring System - Backend API + Poller + Frontend SPA (zero dependency, Node.js >= 22)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "poller": "node poller.js",
    "add-local": "node scripts/add-local-devices.js",
    "scan-lan": "node scripts/scan-lan.js",
    "wifi-scan": "node scripts/wifi-scan.js",
    "identify": "node scripts/identify-hosts.js",
    "cleanup-demo": "node scripts/cleanup-demo-alerts.js",
    "dev": "node server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000 --no-autoupdate",
    "online": "powershell -ExecutionPolicy Bypass -File scripts/online.ps1",
    "verify": "node scripts/verify.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
