{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nms-monitoring",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // URL tunnel aktif. Tunnel quick (trycloudflare) BERGANTI setiap restart â€”
  // jalankan ulang `npm run tunnel` lalu perbarui nilai di sini & commit ulang.
  "vars": {
    "ORIGIN_URL": "https://recent-partition-internal-dressing.trycloudflare.com"
  },

  // Aset statis hanya dipakai sebagai fallback bila origin/tunnel mati.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}

